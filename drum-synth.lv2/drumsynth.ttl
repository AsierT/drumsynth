@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:  <http://moddevices.com/ns/mod#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/AsierT/drumsynth#kick>
  a lv2:Plugin, lv2:InstrumentPlugin ;
  doap:name "DrumSynth Kick" ;
  doap:license "ISC" ;
  mod:brand "DrumSynth" ;
  mod:label "Kick" ;
  lv2:minorVersion 0 ;
  lv2:microVersion 3 ;
  lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> ;
  lv2:port
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 0 ; lv2:symbol "out_l" ; lv2:name "Out L" ] ,
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out_r" ; lv2:name "Out R" ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 2 ; lv2:symbol "pitch" ; lv2:name "Pitch" ; lv2:portProperty lv2:integer ; lv2:default 0 ; lv2:minimum -36 ; lv2:maximum 36 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 3 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "amp_attack" ; lv2:name "Amp Attack" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "amp_decay" ; lv2:name "Amp Decay" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "amp_release" ; lv2:name "Amp Release" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "filter_type" ; lv2:name "Filter Type" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ; lv2:scalePoint [ rdfs:label "Lowpass" ; rdf:value 0 ] , [ rdfs:label "Highpass" ; rdf:value 1 ] , [ rdfs:label "Bandpass" ; rdf:value 2 ] ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "cutoff" ; lv2:name "Cutoff" ; lv2:default 12000 ; lv2:minimum 0 ; lv2:maximum 20000 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "resonance" ; lv2:name "Resonance" ; lv2:default 0.1 ; lv2:minimum 0 ; lv2:maximum 0.98 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "drive" ; lv2:name "Drive" ; lv2:default 0.2 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "filt_env_amt" ; lv2:name "Filter Env Amount" ; lv2:default 4000 ; lv2:minimum 0 ; lv2:maximum 20000 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 12 ; lv2:symbol "filt_attack" ; lv2:name "Filter Attack" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 13 ; lv2:symbol "filt_decay" ; lv2:name "Filter Decay" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 14 ; lv2:symbol "filt_release" ; lv2:name "Filter Release" ; lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 15 ; lv2:symbol "dist_type" ; lv2:name "Dist Type" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 5 ; lv2:scalePoint [ rdfs:label "Clean" ; rdf:value 0 ] , [ rdfs:label "Soft" ; rdf:value 1 ] , [ rdfs:label "Clip" ; rdf:value 2 ] , [ rdfs:label "Drive" ; rdf:value 3 ] , [ rdfs:label "Asym" ; rdf:value 4 ] , [ rdfs:label "Fold" ; rdf:value 5 ] ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 16 ; lv2:symbol "dist_mix" ; lv2:name "Dist Amount" ; lv2:default 0.35 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 17 ; lv2:symbol "glide" ; lv2:name "Glide" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 18 ; lv2:symbol "gate" ; lv2:name "Gate" ; lv2:portProperty lv2:toggled ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a atom:AtomPort, lv2:InputPort ; lv2:index 19 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ; lv2:designation lv2:control ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ] .


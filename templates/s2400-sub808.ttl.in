@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<@URI@>
    a lv2:Plugin ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> ;
    lv2:optionalFeature <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;
    lv2:port
    [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "lv2_audio_in_1" ; lv2:name "Audio Input 1" ] ,
    [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "lv2_audio_in_2" ; lv2:name "Audio Input 2" ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "lv2_audio_out_1" ; lv2:name "Audio Output 1" ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "lv2_audio_out_2" ; lv2:name "Audio Output 2" ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "pitch" ; lv2:name "Pitch" ; lv2:portProperty lv2:integer ; lv2:default 0 ; lv2:minimum -36 ; lv2:maximum 36 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "octave" ; lv2:name "Octave" ; lv2:portProperty lv2:integer ; lv2:default 0 ; lv2:minimum -3 ; lv2:maximum 3 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "tone" ; lv2:name "Tone" ; lv2:default 0.500000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "amp_attack" ; lv2:name "Amp Attack" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "amp_decay" ; lv2:name "Amp Decay" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "amp_release" ; lv2:name "Amp Release" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "filter_type" ; lv2:name "Filter Type" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
      lv2:scalePoint [ rdfs:label "Lowpass" ; rdf:value 0 ] , [ rdfs:label "Highpass" ; rdf:value 1 ] , [ rdfs:label "Bandpass" ; rdf:value 2 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "cutoff" ; lv2:name "Cutoff" ; lv2:portProperty pprops:logarithmic ; lv2:default 20000.000000 ; lv2:minimum 20.000000 ; lv2:maximum 20000.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "resonance" ; lv2:name "Resonance" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 0.980000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "drive" ; lv2:name "Drive" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "filt_env_amt" ; lv2:name "Filter Env Amount" ; lv2:default 0.000000 ; lv2:minimum -1.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "filt_attack" ; lv2:name "Filter Attack" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "filt_decay" ; lv2:name "Filter Decay" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "filt_release" ; lv2:name "Filter Release" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "dist_type" ; lv2:name "Dist Type" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 5 ;
      lv2:scalePoint [ rdfs:label "Clean" ; rdf:value 0 ] , [ rdfs:label "Soft" ; rdf:value 1 ] , [ rdfs:label "Clip" ; rdf:value 2 ] , [ rdfs:label "Drive" ; rdf:value 3 ] , [ rdfs:label "Asym" ; rdf:value 4 ] , [ rdfs:label "Fold" ; rdf:value 5 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "dist_mix" ; lv2:name "Dist Amount" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 20 ; lv2:symbol "glide" ; lv2:name "Glide" ; lv2:default 0.000000 ; lv2:minimum 0.000000 ; lv2:maximum 1.000000 ] ,

    [ a atom:AtomPort, lv2:InputPort ; lv2:index 21 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ; lv2:designation lv2:control ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ] ;

    rdfs:comment "DrumSynth @NAME@ S2400 insert-compatible LV2." ;
    mod:brand "DrumSynth" ;
    mod:label "DrumSynth @NAME@" ;
    doap:name "DrumSynth @NAME@" ;
    doap:license "GPL-2.0-only" ;
    lv2:microVersion 5 ;
    lv2:minorVersion 0 .
